{%- comment -%}
  Rewards (MonkeyBean loyalty). Turn on under Online Store > Themes > Edit theme > App embeds.
  Only invited members see anything: a Yiggybeans badge next to the account icon and
  "Earn X Yiggybeans" under the price on product pages. The Rewards page is at
  /apps/purchase-history/rewards.
{%- endcomment -%}
{%- if customer -%}
  {%- liquid
    if routes.root_url == '/'
      assign ohlp_base = '/apps/purchase-history'
    else
      assign ohlp_base = routes.root_url | append: '/apps/purchase-history'
    endif
  -%}
  <script type="application/json" id="ohlp-config">
    {
      "base": {{ ohlp_base | json }},
      "customer": {{ customer.id | json }},
      "accountUrl": {{ routes.account_url | json }},
      "header": {{ block.settings.show_header | json }},
      "earn": {{ block.settings.show_product | json }},
      "accountSel": {{ block.settings.account_selector | default: "" | json }},
      "priceSel": {{ block.settings.price_selector | default: "" | json }},
      "product": {%- if request.page_type == 'product' and product -%}
        { "variant": {{ product.selected_or_first_available_variant.id | json }}, "prices": { {%- for v in product.variants -%}"{{ v.id }}": {{ v.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} } }
      {%- else -%}null{%- endif %}
    }
  </script>
  <style>
    :root { --ohlp-accent: {{ block.settings.accent }}; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Rewards",
  "target": "body",
  "javascript": "loyalty.js",
  "stylesheet": "loyalty.css",
  "settings": [
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#e0245e" },
    { "type": "checkbox", "id": "show_header", "label": "Yiggybeans badge next to the account icon", "default": true },
    { "type": "checkbox", "id": "show_product", "label": "\"Earn X Yiggybeans\" under product prices", "default": true },
    { "type": "header", "content": "If something doesn't show up" },
    { "type": "paragraph", "content": "Only invited members see these. If one doesn't appear for a member, enter a CSS selector for where it should go." },
    { "type": "text", "id": "account_selector", "label": "Account icon", "placeholder": "a[href='/account']" },
    { "type": "text", "id": "price_selector", "label": "Product price", "placeholder": ".product-single__prices" }
  ]
}
{% endschema %}
